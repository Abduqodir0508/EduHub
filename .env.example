PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/eduhub
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# 100% Bepul Gmail SMTP (Email Verification uchun)
# Google hisobingizdan "App Passwords" (Ilova parollari) bo'limidan 16 xonali maxsus parol olinadi
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_character_gmail_app_password
